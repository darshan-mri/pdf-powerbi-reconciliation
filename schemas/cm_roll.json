{
  "name": "cm_roll",
  "version": 1,
  "report": "CM.ROLL",
  "mode": "row",
  "description": "CM Commercial Rent Roll - suite/unit level extraction.",
  "source": {
    "config_key": "PDF",
    "engine": "pymupdf"
  },
  "output": {
    "config_key": "ExtractedAuto",
    "sheet": "Unit Level"
  },
  "record": {
    "default_state": "Unknown",
    "start_patterns": [
      "^\\d{3}[A-Z]\\d{2}\\b"
    ],
    "start_candidates": [
      "^\\d{3}[A-Z]\\d{2}\\s",
      "^\\d{2,4}[A-Z]\\d{1,3}\\b",
      "^[0-9]{3}[A-Za-z][0-9]{2}",
      "^\\d{3}-[A-Z]\\d{2}\\b"
    ],
    "noise_patterns": [
      "^(C\\d+|GST|T\\d+|R\\d+|FIT)"
    ],
    "skip_contains": [
      "Database:",
      "Page:",
      "Rent Roll"
    ],
    "state_markers": {
      "Occupied Units": "Occupied",
      "Vacant Units": "Vacant",
      "New Leases": "New",
      "Excluded": "Excluded"
    }
  },
  "fields": [
    {
      "name": "Building ID",
      "strategy": "token",
      "index": 0,
      "type": "str",
      "required": true,
      "description": "Leading building code, e.g. 001A01"
    },
    {
      "name": "Suite ID",
      "strategy": "token",
      "index": 1,
      "type": "str",
      "required": false,
      "description": "Second token; literally 'Vacant' on vacant rows"
    },
    {
      "name": "Occupant Name",
      "strategy": "regex",
      "patterns": [
        "\\d{1,2}/\\d{1,2}/\\d{4}\\s+([A-Za-z][^\\d]*?)\\s+-?[\\d,]*\\d\\.\\d{2}"
      ],
      "candidates": [
        "\\d{1,2}/\\d{1,2}/\\d{4}\\s+([A-Za-z][^\\d]*)",
        "^\\S+\\s+\\S+\\s+(.+?)\\s+\\d{1,2}/\\d{1,2}/\\d{4}",
        "^\\S+\\s+(.+?)\\s+\\d{1,2}/\\d{1,2}/\\d{4}"
      ],
      "group": 1,
      "type": "str",
      "transform": "collapse_space",
      "required": false
    },
    {
      "name": "Rent Start",
      "strategy": "date",
      "index": 0,
      "type": "str"
    },
    {
      "name": "Expiration",
      "strategy": "date",
      "index": 1,
      "type": "str"
    },
    {
      "name": "GLA Sqft",
      "strategy": "number",
      "index": 0,
      "type": "float",
      "description": "Compared against Power BI"
    },
    {
      "name": "Monthly Base Rent",
      "strategy": "number",
      "index": 1,
      "type": "float",
      "description": "Compared against Power BI"
    },
    {
      "name": "Annual Rate PSF",
      "strategy": "number",
      "index": 2,
      "type": "float",
      "description": "Compared against Power BI"
    },
    {
      "name": "Status",
      "strategy": "state",
      "type": "str",
      "default": "Unknown"
    }
  ],
  "validation": {
    "min_rows": 1,
    "min_fill_rate": {
      "Building ID": 0.98,
      "Suite ID": 0.80,
      "GLA Sqft": 0.60
    },
    "ranges": {},
    "drop_if_all_null": [
      "GLA Sqft",
      "Monthly Base Rent",
      "Annual Rate PSF"
    ]
  },
  "history": []
}




